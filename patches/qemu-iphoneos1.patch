+         * sparse-page representation when erased-page-fill is left at zero.
+         */
+        if (data) {
+            memset(data, s->erased_page_fill, NAND_BYTES_PER_PAGE);
+        }
+        if (spare) {
+            memset(spare, s->erased_page_fill, NAND_BYTES_PER_SPARE);
+            spare[0xa] = 0xff;
+        }
+        return;
