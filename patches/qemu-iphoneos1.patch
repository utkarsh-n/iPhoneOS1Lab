+static void nand_flush_page(ITNandState *s)
+{
+    g_autofree char *filename = NULL;
+    g_autofree char *temporary = NULL;
+    FILE *file;
+    int fd, error;
+    bool overlay = nand_has_overlay(s);
+
+    nand_validate_page(s->buffered_bank, s->buffered_page);
+    filename = g_strdup_printf("%s/bank%u/%u%s.page",
+                               overlay ? s->nand_overlay : s->nand_path,
+                               s->buffered_bank, s->buffered_page,
+                               overlay ? "" : "_new");
+    temporary = g_strdup_printf("%s.tmp-XXXXXX", filename);
+    fd = g_mkstemp(temporary);
+    if (fd < 0) {
+        hw_error("NAND: unable to create %s: %s", temporary, g_strerror(errno));
+    }
+    file = fdopen(fd, "wb");
+    if (!file) {
+        error = errno;
+        close(fd);
+        unlink(temporary);
+        hw_error("NAND: unable to open temporary page: %s", g_strerror(error));
+    }
