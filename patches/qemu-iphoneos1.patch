+        unsigned length = z1_frame_length(s);
+        s->z1_command = value;
+        memset(s->z1_in, 0, sizeof(s->z1_in));
+        memset(s->z1_out, 0, sizeof(s->z1_out));
+        s->z1_out[0] = s->z1_running ? 0xaa : 0xd0;
