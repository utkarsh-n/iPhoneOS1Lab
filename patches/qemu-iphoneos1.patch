+            s->z1_length = 4;
+            s->z1_out[1] = MT_INTERFACE_VERSION;
+            stw_be_p(s->z1_out + 2, MT_MAX_PACKET_SIZE);
+            break;
+        case 0x8f: /* Report metadata; report ID arrives in byte 1. */
+            s->z1_length = 8;
+            break;
+        case 0x82: /* Report read, report ID arrives in byte 1. */
+        case 0x92: /* Report write, report ID arrives in byte 1. */
+            s->z1_length = 6;
+            break;
+        case 0x46: /* Interface <= 0x10: compact frame-length response. */
+            s->z1_length = 8;
+            stw_be_p(s->z1_out + 1, length);
+            stw_be_p(s->z1_out + 3,
+                     s->z1_out[1] + s->z1_out[2]);
+            break;
+        case 0x64: /* Interface > 0x10: extended frame-length response. */
+        case 0x65:
+            s->z1_length = 8;
+            stw_be_p(s->z1_out + 4, length);
+            stw_be_p(s->z1_out + 6,
+                     s->z1_out[4] + s->z1_out[5]);
+            break;
+        case 0x47:
+        case 0x68:
+            z1_prepare_frame(s);
