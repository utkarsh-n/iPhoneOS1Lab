+            NAND_BYTES_PER_SPARE || fflush(file) || fsync(fd)) {
+        error = errno;
+        fclose(file);
+        unlink(temporary);
+        qemu_mutex_unlock(&s->lock);
+        hw_error("NAND: unable to write complete page: %s", g_strerror(error));
+    }
+    if (fclose(file) || rename(temporary, filename)) {
+        error = errno;
+        unlink(temporary);
+        qemu_mutex_unlock(&s->lock);
+        hw_error("NAND: unable to publish complete page: %s", g_strerror(error));
+    }
+    qemu_mutex_unlock(&s->lock);
+}
 
