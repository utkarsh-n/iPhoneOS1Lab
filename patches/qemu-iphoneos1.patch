+
+void ipod_touch_sysic_gpio_input(IPodTouchSYSICState *s, unsigned interrupt,
+                                bool high)
+{
+    unsigned group = interrupt / 32;
+    uint32_t bit = 1U << (interrupt % 32);
+    bool known, old_high;
+
+    if (group >= GPIO_NUMINTGROUPS) {
+        hw_error("SYSIC: invalid GPIO input %u", interrupt);
+    }
+    known = (s->gpio_input_known[group] & bit) != 0;
+    old_high = (s->gpio_input_level[group] & bit) != 0;
+    s->gpio_input_known[group] |= bit;
+    s->gpio_input_level[group] = (s->gpio_input_level[group] & ~bit) |
+                                 (high ? bit : 0);
+    if (known && old_high != high && !(s->gpio_int_type[group] & bit) &&
+        high == ((s->gpio_int_level[group] & bit) != 0)) {
+        s->gpio_int_status[group] |= bit;
+    }
+    ipod_touch_sysic_update_gpio(s, group);
+}
+
+void ipod_touch_sysic_gpio_event(IPodTouchSYSICState *s, unsigned interrupt)
+{
+    unsigned group = interrupt / 32;
+    uint32_t bit = 1U << (interrupt % 32);
+
+    if (group >= GPIO_NUMINTGROUPS) {
+        hw_error("SYSIC: invalid GPIO event %u", interrupt);
+    }
+    s->gpio_int_status[group] |= bit;
+    if (s->iphone_2g) {
+        ipod_touch_sysic_update_gpio(s, group);
+    } else {
+        qemu_irq_raise(s->gpio_irqs[group]);
+    }
