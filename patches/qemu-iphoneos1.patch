+{
+    FILE *file = NULL;
+    uint8_t contents[NAND_BYTES_PER_PAGE + NAND_BYTES_PER_SPARE];
+
+    nand_validate_page(bank, page);
+    if (nand_has_overlay(s)) {
+        file = nand_open_page(s->nand_overlay, bank, page);
+    }
+    if (!file) {
+        file = nand_open_page(s->nand_path, bank, page);
+    }
