+    if (s->z1_index == 1) {
+        uint8_t report = value;
+        unsigned length = z1_report_size(report);
+
+        switch (s->z1_command) {
+        case 0x8f:
+            s->z1_out[1] = report;
+            /* The upper nibble is a report error, not a length bit. */
+            s->z1_out[4] = length ? length >> 8 : 0x10;
+            s->z1_out[5] = length;
+            stw_be_p(s->z1_out + 6,
+                     report + s->z1_out[4] + s->z1_out[5]);
+            break;
+        case 0x82:
+            z1_prepare_report(s, report);
+            s->z1_length = length + 6;
+            break;
+        case 0x92:
+            if (report != MT_REPORT_UNKNOWN1) {
+                hw_error("Zephyr 1: unsupported report write 0x%02x", report);
+            }
+            s->z1_out[1] = report;
+            s->z1_length = length + 6;
+            break;
+        }
+    }
+    if (s->z1_command == 0x92 && s->z1_index == s->z1_length - 3) {
+        uint16_t checksum = s->z1_in[1];
+        for (i = 4; i < s->z1_length - 2; i++) {
+            checksum += s->z1_in[i];
+        }
+        stw_be_p(s->z1_out + s->z1_length - 2, checksum);
+    }
+
+    result = s->z1_out[s->z1_index++];
+    if (s->z1_index == s->z1_length) {
+        switch (s->z1_command) {
+        case 0xc2: {
+            uint32_t address = ldl_be_p(s->z1_in + 1);
+            uint16_t checksum = 0;
+            for (i = 0; i < MT_Z1_PACKET_SIZE - 2; i++) {
+                checksum += s->z1_in[i];
+            }
+            s->z1_upload_checksum = checksum;
+            s->z1_upload_valid =
+                checksum == lduw_be_p(s->z1_in + MT_Z1_PACKET_SIZE - 2) &&
+                address >= 0x40000000 &&
+                address - 0x40000000 <= MT_Z1_FIRMWARE_RAM_SIZE - 0x3f8;
+            if (s->z1_upload_valid) {
+                memcpy(s->z1_firmware + address - 0x40000000,
+                       s->z1_in + 6, 0x3f8);
+            }
+            break;
+        }
+        case 0xc4:
+            s->z1_running = s->z1_upload_valid &&
+                s->z1_in[1] == 0 && s->z1_in[2] == 0 &&
+                s->z1_in[3] == 0xc4;
+            break;
+        case 0x92:
+            if (s->z1_in[1] == MT_REPORT_UNKNOWN1 &&
+                lduw_be_p(s->z1_in + s->z1_length - 2) ==
+                lduw_be_p(s->z1_out + s->z1_length - 2)) {
+                s->z1_report70 = s->z1_in[4];
+            }
+            break;
+        case 0x47:
+        case 0x68:
+            free(s->next_frame);
+            s->next_frame = NULL;
+            break;
+        }
+        s->z1_index = 0;
+        s->z1_command = 0;
+    }
+    return result;
+}
+
+/*
+ * The original kernel sends C2 00 00 00 in a separate SPI transaction before
+ * its raw main-firmware stream (1A543a: c03c756c-c03c77bc). This boundary must
+ * come from chip select, not a temporarily empty SPI FIFO.
+ */
+void ipod_touch_multitouch_end_transfer(IPodTouchMultitouchState *s)
+{
+    if (!s->zephyr1) {
+        return;
+    }
+    if (s->z1_main_upload) {
+        if (s->z1_main_length) {
+            s->z1_upload_valid = true;
+            s->z1_main_upload = false;
+        }
+        return;
+    }
+    if (s->z1_command == 0xc2 && s->z1_index == 4 &&
+        s->z1_in[1] == 0 && s->z1_in[2] == 0 && s->z1_in[3] == 0) {
+        s->z1_main_upload = true;
+        s->z1_main_length = 0;
+        s->z1_upload_checksum = 0;
+        s->z1_upload_valid = false;
+        s->z1_index = 0;
+        s->z1_command = 0;
+    } else if (s->z1_index) {
+        hw_error("Zephyr 1: truncated command 0x%02x (%u of %u bytes)",
+                 s->z1_command, s->z1_index, s->z1_length);
+    }
+}
 
