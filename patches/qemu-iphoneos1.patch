+static void ipod_touch_sysic_update_gpio(IPodTouchSYSICState *s, unsigned group)
+{
+    uint32_t level_bits = s->gpio_int_type[group];
+    uint32_t active = ~(s->gpio_input_level[group] ^ s->gpio_int_level[group]) &
+                      s->gpio_input_known[group] & level_bits;
