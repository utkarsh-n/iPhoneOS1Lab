+        case 0xc2: /* Download: C2, addressBE, reserved, data, checksumBE. */
+            s->z1_length = MT_Z1_PACKET_SIZE;
+            s->z1_running = false;
+            s->z1_out[0] = 0;
+            break;
+        case 0xc4: /* Execute: C4 00 00 C4. */
+            s->z1_length = 4;
+            s->z1_out[0] = 0;
