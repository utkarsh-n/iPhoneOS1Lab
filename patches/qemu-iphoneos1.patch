+/*
+ * Zephyr 1 packet formats are verified against the original 1A543a kernel's
+ * AppleMultitouchSPI driver and openiBoot's multitouch-z1.c. This models the
+ * controller protocol and downloaded RAM; it does not execute ASIC firmware.
+ * Zephyr 2 continues through the original transfer handler below.
+ */
+static unsigned z1_report_size(uint8_t report)
+{
+    switch (report) {
+    case MT_REPORT_UNKNOWN1:
+    case MT_REPORT_FAMILY_ID:
+    case MT_REPORT_SENSOR_REGION_DESC:
+    case MT_REPORT_SENSOR_REGION_PARAM:
+        return 1;
+    case MT_REPORT_SENSOR_INFO:
+        return 5;
+    case MT_REPORT_SENSOR_DIMENSIONS:
+        return 8;
+    default:
+        return 0;
+    }
+}
+
+static void z1_prepare_report(IPodTouchMultitouchState *s, uint8_t report)
+{
+    uint8_t *data = s->z1_out + 4;
+    unsigned length = z1_report_size(report);
+    uint16_t checksum = report;
+    unsigned i;
+
+    s->z1_out[1] = report;
+    switch (report) {
+    case MT_REPORT_UNKNOWN1:
+        data[0] = s->z1_report70;
+        break;
+    case MT_REPORT_FAMILY_ID:
+        data[0] = MT_FAMILY_ID;
+        break;
+    case MT_REPORT_SENSOR_INFO:
+        data[0] = MT_ENDIANNESS;
+        data[1] = MT_SENSOR_ROWS;
+        data[2] = MT_SENSOR_COLUMNS;
+        stw_be_p(data + 3, MT_BCD_VERSION);
+        break;
+    case MT_REPORT_SENSOR_REGION_DESC:
+        data[0] = MT_SENSOR_REGION_DESC;
+        break;
+    case MT_REPORT_SENSOR_REGION_PARAM:
+        data[0] = MT_SENSOR_REGION_PARAM;
+        break;
+    case MT_REPORT_SENSOR_DIMENSIONS:
+        stl_le_p(data, MT_SENSOR_SURFACE_WIDTH);
+        stl_le_p(data + 4, MT_SENSOR_SURFACE_HEIGHT);
+        break;
+    default:
+        hw_error("Zephyr 1: unsupported report read 0x%02x", report);
+    }
+    for (i = 0; i < length; i++) {
+        checksum += data[i];
+    }
+    stw_be_p(data + length, checksum);
+}
+
+static unsigned z1_frame_length(IPodTouchMultitouchState *s)
+{
+    return s->next_frame ? sizeof(MTFrameHeader) + sizeof(FingerData) + 2 : 0;
+}
+
+static void z1_prepare_frame(IPodTouchMultitouchState *s)
+{
+    unsigned length = z1_frame_length(s);
+    uint16_t checksum = 0;
+    unsigned i;
+
+    if (!length) {
+        /* Empty result: marker and a checksum over an empty payload. */
+        s->z1_length = 3;
+        return;
+    }
+    memcpy(s->z1_out + 1, &s->next_frame->frame_packet.header,
+           sizeof(MTFrameHeader));
+    memcpy(s->z1_out + 1 + sizeof(MTFrameHeader),
+           &s->next_frame->finger_data, sizeof(FingerData));
+    for (i = 1; i < length - 1; i++) {
+        checksum += s->z1_out[i];
+    }
+    stw_be_p(s->z1_out + length - 1, checksum);
+    s->z1_length = length + 1;
+}
+
+static uint32_t zephyr1_transfer(IPodTouchMultitouchState *s, uint8_t value)
+{
+    uint8_t result;
+    unsigned i;
+
+    if (s->z1_main_upload) {
+        if (s->z1_main_length == sizeof(s->z1_main_firmware)) {
+            hw_error("Zephyr 1: main firmware exceeds modeled download buffer");
+        }
+        s->z1_main_firmware[s->z1_main_length++] = value;
+        s->z1_upload_checksum += value;
+        return 0;
+    }
+
