+
+static bool s5l8900_lcd_scanout(IPodTouchLCDState *lcd, hwaddr *base,
+                              int *width, int *height, int *stride)
+{
+    const S5L8900LCDWindow windows[] = {
+        { 0x40, lcd->w1_hspan, lcd->w1_display_depth_info,
+          lcd->w1_framebuffer_base, lcd->w1_display_resolution_info },
+        { 0x20, lcd->w2_hspan, lcd->w2_display_depth_info,
+          lcd->w2_framebuffer_base, lcd->w2_display_resolution_info },
+        { 0x10, lcd->w3_hspan, lcd->w3_display_depth_info,
+          lcd->w3_framebuffer_base, lcd->w3_display_resolution_info },
+        { 0x08, lcd->w4_hspan, lcd->w4_display_depth_info,
+          lcd->w4_framebuffer_base, lcd->w4_display_resolution_info },
+    };
+    const S5L8900LCDWindow *window = NULL;
+    uint64_t span;
+    unsigned i, format;
+
+    /* Match the priority used by 1A543a AppleH1CLCD at c03007c4. */
+    for (i = 0; i < ARRAY_SIZE(windows); i++) {
+        if (lcd->lcd_con2 & windows[i].enable) {
+            window = &windows[i];
+            break;
+        }
+    }
+
+    if (!window) {
+        /* Preserve the upstream N45 scanout before window setup is modeled. */
+        *base = lcd->w1_framebuffer_base;
+        *width = 320;
+        *height = 480;
+        *stride = 1280;
+        return true;
+    }
+
+    format = (window->depth >> 8) & 7;
+    /* The kernel identifies formats 6 and 7 as four-byte ARGB, not RGB24. */
+    if (format != 6 && format != 7) {
+        return false;
+    }
+
+    *base = window->base;
+    *width = (window->resolution >> 16) & 0x7ff;
+    *height = window->resolution & 0x3ff;
+    *stride = window->stride;
+    if (!*width || !*height || *stride < 4 * *width ||
+        *stride > 65536) {
+        return false;
+    }
+    span = (uint64_t)*height * *stride;
+    return span <= 64 * MiB && *base <= UINT32_MAX - span;
+}
