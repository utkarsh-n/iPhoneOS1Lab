+        fgetc(file) != EOF || ferror(file)) {
+        fclose(file);
+        hw_error("NAND: invalid page length at bank %u, page %u", bank, page);
+    }
+    if (fclose(file)) {
+        hw_error("NAND: unable to close page at bank %u, page %u: %s",
+                 bank, page, g_strerror(errno));
+    }
+    if (data) {
+        memcpy(data, contents, NAND_BYTES_PER_PAGE);
+    }
