index 390309f19d17236e058fd0fbfb4d7531a410d0fa..88fb35e7e7c0ada7e80a9dc563a29fced1c30f19 100644
--- a/hw/arm/ipod_touch_adm.c
+++ b/hw/arm/ipod_touch_adm.c
@@ -2,6 +2,126 @@
 #include "hw/qdev-properties.h"
 #include "hw/arm/ipod_touch_nand.h"
 #include "qapi/error.h"
+#include "qemu/bswap.h"
+
+static void adm_read_buffer(IPodTouchADMState *s, hwaddr address,
+                           void *buffer, size_t length)
+{
+    if (address_space_read(&s->downstream_as, address,
+                           MEMTXATTRS_UNSPECIFIED, buffer, length) != MEMTX_OK) {
+        hw_error("ADM: unmapped descriptor read at 0x%" HWADDR_PRIx, address);
+    }
+}
+
+static void adm_write_buffer(IPodTouchADMState *s, hwaddr address,
+                            const void *buffer, size_t length)
+{
+    if (address_space_write(&s->downstream_as, address,
+                            MEMTXATTRS_UNSPECIFIED, buffer, length) != MEMTX_OK) {
+        hw_error("ADM: unmapped response write at 0x%" HWADDR_PRIx, address);
+    }
+}
+
+static unsigned adm_available_bank_count(IPodTouchADMState *s)
+{
+    unsigned count = 0;
+    unsigned bank;
+
+    for (bank = 0; bank < NAND_NUM_BANKS; bank++) {
+        count += (s->nand_state->bank_mask >> bank) & 1;
+    }
+    return count;
+}
+
+static void adm_validate_page_count(IPodTouchADMState *s, unsigned count,
+                                   bool interleaved)
+{
+    unsigned banks = adm_available_bank_count(s);
+
+    if (!count || count > ARRAY_SIZE(s->nand_state->pages_to_read) ||
+        (interleaved && (!banks || count % banks))) {
+        hw_error("ADM: unsupported page count %u%s", count,
+                 interleaved ? " for interleaved read" : "");
+    }
+}
+
+static void adm_validate_bank(IPodTouchADMState *s, unsigned bank)
+{
+    if (bank >= NAND_NUM_BANKS ||
+        !(s->nand_state->bank_mask & (1U << bank))) {
+        hw_error("ADM: invalid NAND bank %u", bank);
+    }
+}
+
+static void adm_validate_page(uint32_t page)
+{
+    if (page >= NAND_PAGES_PER_BANK) {
+        hw_error("ADM: invalid NAND page %u", page);
+    }
+}
+
+static bool adm_bytes_erased(const uint8_t *bytes, size_t length)
+{
+    size_t i;
+
+    for (i = 0; i < length; i++) {
+        if (bytes[i] != 0xff) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool adm_page_erased(const uint8_t *data, const uint8_t *spare)
+{
+    return adm_bytes_erased(data, NAND_BYTES_PER_PAGE) &&
+           adm_bytes_erased(spare, NAND_BYTES_PER_SPARE);
+}
+
+static unsigned adm_m68_spare_stride(IPodTouchADMState *s, hwaddr packet_base)
+{
+    uint8_t bytes[2];
+    unsigned stride;
+
+    /* c0425180-c0425198 writes the caller's spare record size here;
+     * c042578c-c04257a8 copies count*size bytes from section3 unchanged.
+     */
+    adm_read_buffer(s, packet_base + 0x2c, bytes, sizeof(bytes));
+    stride = lduw_be_p(bytes);
+    if (stride > NAND_BYTES_PER_SPARE) {
+        hw_error("ADM: unsupported M68 spare record size %u", stride);
+    }
+    return stride;
+}
+
+static void adm_write_multi_spares(IPodTouchADMState *s, hwaddr packet_base,
+                                    unsigned count)
+{
+    unsigned stride = s->m68_layout ?
+                      adm_m68_spare_stride(s, packet_base) : 0xc;
+    bool all_erased = true;
+    unsigned i;
+
+    for (i = 0; i < count; i++) {
+        uint8_t data[NAND_BYTES_PER_PAGE];
+        uint8_t spare[NAND_BYTES_PER_SPARE] = {0};
+
+        if (s->m68_layout) {
+            nand_read_page(s->nand_state, s->nand_state->banks_to_read[i],
+                           s->nand_state->pages_to_read[i], data, spare);
+            all_erased &= adm_page_erased(data, spare);
+        } else {
+            spare[10] = 0xff;
+        }
+        if (stride) {
+            adm_write_buffer(s, (hwaddr)s->data3_sec_addr + i * stride,
+                             spare, stride);
+        }
+    }
+    if (s->m68_layout && all_erased) {
+        s->completion[2] = 0xfe;
+    }
+}
 
