diff --git a/hw/arm/ipod_touch_multitouch.c b/hw/arm/ipod_touch_multitouch.c
index 8a1c94d..bc2e878 100644
--- a/hw/arm/ipod_touch_multitouch.c
+++ b/hw/arm/ipod_touch_multitouch.c
@@ -1,4 +1,279 @@
 #include "hw/arm/ipod_touch_multitouch.h"
+#include "qemu/bswap.h"
+
+/*
+ * Zephyr 1 packet formats are verified against the original 1A543a kernel's
+ * AppleMultitouchSPI driver and openiBoot's multitouch-z1.c. This models the
+ * controller protocol and downloaded RAM; it does not execute ASIC firmware.
+ * Zephyr 2 continues through the original transfer handler below.
+ */
+static unsigned z1_report_size(uint8_t report)
+{
+    switch (report) {
+    case MT_REPORT_UNKNOWN1:
+    case MT_REPORT_FAMILY_ID:
+    case MT_REPORT_SENSOR_REGION_DESC:
+    case MT_REPORT_SENSOR_REGION_PARAM:
+        return 1;
+    case MT_REPORT_SENSOR_INFO:
+        return 5;
+    case MT_REPORT_SENSOR_DIMENSIONS:
+        return 8;
+    default:
+        return 0;
+    }
+}
+
+static void z1_prepare_report(IPodTouchMultitouchState *s, uint8_t report)
+{
+    uint8_t *data = s->z1_out + 4;
+    unsigned length = z1_report_size(report);
+    uint16_t checksum = report;
+    unsigned i;
+
+    s->z1_out[1] = report;
+    switch (report) {
+    case MT_REPORT_UNKNOWN1:
+        data[0] = s->z1_report70;
+        break;
+    case MT_REPORT_FAMILY_ID:
+        data[0] = MT_FAMILY_ID;
+        break;
+    case MT_REPORT_SENSOR_INFO:
+        data[0] = MT_ENDIANNESS;
+        data[1] = MT_SENSOR_ROWS;
+        data[2] = MT_SENSOR_COLUMNS;
+        stw_be_p(data + 3, MT_BCD_VERSION);
+        break;
+    case MT_REPORT_SENSOR_REGION_DESC:
+        data[0] = MT_SENSOR_REGION_DESC;
+        break;
+    case MT_REPORT_SENSOR_REGION_PARAM:
+        data[0] = MT_SENSOR_REGION_PARAM;
+        break;
+    case MT_REPORT_SENSOR_DIMENSIONS:
+        stl_le_p(data, MT_SENSOR_SURFACE_WIDTH);
+        stl_le_p(data + 4, MT_SENSOR_SURFACE_HEIGHT);
+        break;
+    default:
+        hw_error("Zephyr 1: unsupported report read 0x%02x", report);
+    }
+    for (i = 0; i < length; i++) {
+        checksum += data[i];
+    }
+    stw_be_p(data + length, checksum);
+}
+
+static unsigned z1_frame_length(IPodTouchMultitouchState *s)
+{
+    return s->next_frame ? sizeof(MTFrameHeader) + sizeof(FingerData) + 2 : 0;
+}
+
+static void z1_prepare_frame(IPodTouchMultitouchState *s)
+{
+    unsigned length = z1_frame_length(s);
+    uint16_t checksum = 0;
+    unsigned i;
+
+    if (!length) {
+        /* Empty result: marker and a checksum over an empty payload. */
+        s->z1_length = 3;
+        return;
+    }
+    memcpy(s->z1_out + 1, &s->next_frame->frame_packet.header,
+           sizeof(MTFrameHeader));
+    memcpy(s->z1_out + 1 + sizeof(MTFrameHeader),
+           &s->next_frame->finger_data, sizeof(FingerData));
+    for (i = 1; i < length - 1; i++) {
+        checksum += s->z1_out[i];
+    }
+    stw_be_p(s->z1_out + length - 1, checksum);
+    s->z1_length = length + 1;
+}
+
+static uint32_t zephyr1_transfer(IPodTouchMultitouchState *s, uint8_t value)
+{
+    uint8_t result;
+    unsigned i;
+
+    if (s->z1_main_upload) {
+        if (s->z1_main_length == sizeof(s->z1_main_firmware)) {
+            hw_error("Zephyr 1: main firmware exceeds modeled download buffer");
+        }
+        s->z1_main_firmware[s->z1_main_length++] = value;
+        s->z1_upload_checksum += value;
+        return 0;
+    }
+
+    if (!s->z1_index) {
+        unsigned length = z1_frame_length(s);
+        s->z1_command = value;
+        memset(s->z1_in, 0, sizeof(s->z1_in));
+        memset(s->z1_out, 0, sizeof(s->z1_out));
+        s->z1_out[0] = s->z1_running ? 0xaa : 0xd0;
+
+        switch (value) {
+        case 0xc2: /* Download: C2, addressBE, reserved, data, checksumBE. */
+            s->z1_length = MT_Z1_PACKET_SIZE;
+            s->z1_running = false;
+            s->z1_out[0] = 0;
+            break;
+        case 0xc4: /* Execute: C4 00 00 C4. */
+            s->z1_length = 4;
+            s->z1_out[0] = 0;
+            break;
+        case 0x05: /* Checksum query: 05 00 00 06. */
+            s->z1_length = 4;
+            s->z1_out[0] = 0xd0;
+            s->z1_out[1] = s->z1_upload_valid ? 0 : 1;
+            stw_be_p(s->z1_out + 2, s->z1_upload_checksum);
+            break;
+        case 0xd0: /* Interface query, four bytes, big-endian packet size. */
+            s->z1_length = 4;
+            s->z1_out[1] = MT_INTERFACE_VERSION;
+            stw_be_p(s->z1_out + 2, MT_MAX_PACKET_SIZE);
+            break;
+        case 0x8f: /* Report metadata; report ID arrives in byte 1. */
+            s->z1_length = 8;
+            break;
+        case 0x82: /* Report read, report ID arrives in byte 1. */
+        case 0x92: /* Report write, report ID arrives in byte 1. */
+            s->z1_length = 6;
+            break;
+        case 0x46: /* Interface <= 0x10: compact frame-length response. */
+            s->z1_length = 8;
+            stw_be_p(s->z1_out + 1, length);
+            stw_be_p(s->z1_out + 3,
+                     s->z1_out[1] + s->z1_out[2]);
+            break;
+        case 0x64: /* Interface > 0x10: extended frame-length response. */
+        case 0x65:
+            s->z1_length = 8;
+            stw_be_p(s->z1_out + 4, length);
+            stw_be_p(s->z1_out + 6,
+                     s->z1_out[4] + s->z1_out[5]);
+            break;
+        case 0x47:
+        case 0x68:
+            z1_prepare_frame(s);
+            break;
+        default:
+            hw_error("Zephyr 1: unsupported command 0x%02x", value);
+        }
+    }
+
+    if (s->z1_index >= MT_Z1_PACKET_SIZE) {
+        hw_error("Zephyr 1: packet exceeds modeled transfer buffer");
+    }
+    s->z1_in[s->z1_index] = value;
+    if (s->z1_index == 1) {
+        uint8_t report = value;
+        unsigned length = z1_report_size(report);
+
+        switch (s->z1_command) {
+        case 0x8f:
+            s->z1_out[1] = report;
+            /* The upper nibble is a report error, not a length bit. */
+            s->z1_out[4] = length ? length >> 8 : 0x10;
+            s->z1_out[5] = length;
+            stw_be_p(s->z1_out + 6,
+                     report + s->z1_out[4] + s->z1_out[5]);
+            break;
+        case 0x82:
+            z1_prepare_report(s, report);
+            s->z1_length = length + 6;
+            break;
+        case 0x92:
+            if (report != MT_REPORT_UNKNOWN1) {
+                hw_error("Zephyr 1: unsupported report write 0x%02x", report);
+            }
+            s->z1_out[1] = report;
+            s->z1_length = length + 6;
+            break;
+        }
+    }
+    if (s->z1_command == 0x92 && s->z1_index == s->z1_length - 3) {
+        uint16_t checksum = s->z1_in[1];
+        for (i = 4; i < s->z1_length - 2; i++) {
+            checksum += s->z1_in[i];
+        }
+        stw_be_p(s->z1_out + s->z1_length - 2, checksum);
+    }
+
+    result = s->z1_out[s->z1_index++];
+    if (s->z1_index == s->z1_length) {
+        switch (s->z1_command) {
+        case 0xc2: {
+            uint32_t address = ldl_be_p(s->z1_in + 1);
+            uint16_t checksum = 0;
+            for (i = 0; i < MT_Z1_PACKET_SIZE - 2; i++) {
+                checksum += s->z1_in[i];
+            }
+            s->z1_upload_checksum = checksum;
+            s->z1_upload_valid =
+                checksum == lduw_be_p(s->z1_in + MT_Z1_PACKET_SIZE - 2) &&
+                address >= 0x40000000 &&
+                address - 0x40000000 <= MT_Z1_FIRMWARE_RAM_SIZE - 0x3f8;
+            if (s->z1_upload_valid) {
+                memcpy(s->z1_firmware + address - 0x40000000,
+                       s->z1_in + 6, 0x3f8);
+            }
+            break;
+        }
+        case 0xc4:
+            s->z1_running = s->z1_upload_valid &&
+                s->z1_in[1] == 0 && s->z1_in[2] == 0 &&
+                s->z1_in[3] == 0xc4;
+            break;
+        case 0x92:
+            if (s->z1_in[1] == MT_REPORT_UNKNOWN1 &&
+                lduw_be_p(s->z1_in + s->z1_length - 2) ==
+                lduw_be_p(s->z1_out + s->z1_length - 2)) {
+                s->z1_report70 = s->z1_in[4];
+            }
+            break;
+        case 0x47:
+        case 0x68:
+            free(s->next_frame);
+            s->next_frame = NULL;
+            break;
+        }
+        s->z1_index = 0;
+        s->z1_command = 0;
+    }
+    return result;
+}
+
+/*
+ * The original kernel sends C2 00 00 00 in a separate SPI transaction before
+ * its raw main-firmware stream (1A543a: c03c756c-c03c77bc). This boundary must
+ * come from chip select, not a temporarily empty SPI FIFO.
+ */
+void ipod_touch_multitouch_end_transfer(IPodTouchMultitouchState *s)
+{
+    if (!s->zephyr1) {
+        return;
+    }
+    if (s->z1_main_upload) {
+        if (s->z1_main_length) {
+            s->z1_upload_valid = true;
+            s->z1_main_upload = false;
+        }
+        return;
+    }
+    if (s->z1_command == 0xc2 && s->z1_index == 4 &&
+        s->z1_in[1] == 0 && s->z1_in[2] == 0 && s->z1_in[3] == 0) {
+        s->z1_main_upload = true;
+        s->z1_main_length = 0;
+        s->z1_upload_checksum = 0;
+        s->z1_upload_valid = false;
+        s->z1_index = 0;
+        s->z1_command = 0;
+    } else if (s->z1_index) {
+        hw_error("Zephyr 1: truncated command 0x%02x (%u of %u bytes)",
+                 s->z1_command, s->z1_index, s->z1_length);
+    }
+}
 
