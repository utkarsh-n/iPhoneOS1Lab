diff --git a/include/hw/arm/ipod_touch_8900_engine.h b/include/hw/arm/ipod_touch_8900_engine.h
index a43089f..c60487a 100644
--- a/include/hw/arm/ipod_touch_8900_engine.h
+++ b/include/hw/arm/ipod_touch_8900_engine.h
@@ -60,17 +60,31 @@ static void s5l8900_8900_engine_write(void *opaque, hwaddr offset, uint64_t valu
     header8900 *header = malloc(sizeof(header8900));
     address_space_rw(nsas, value, MEMTXATTRS_UNSPECIFIED, (uint8_t *)header, sizeof(header8900), 0);
 
-	if( (header->magic[0] != 0x38) && // 8
-	    (header->magic[1] != 0x39) && // 9
-	    (header->magic[2] != 0x30) && // 0
+	if( (header->magic[0] != 0x38) || // 8
+	    (header->magic[1] != 0x39) || // 9
+	    (header->magic[2] != 0x30) || // 0
 	    (header->magic[3] != 0x30))  // 0
 	{
 		printf("Bad 8900 magic\n");
