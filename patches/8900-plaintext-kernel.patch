 		return;
 	}
 
-	if(header->encrypted == 0x03) { encrypted = 1; }
-	else if( header->encrypted = 0x04 ) { encrypted = 0; }
+	/* The original 1A543a system kernel is a plaintext 8900 container.
+	 * Decrypting it corrupts the complzss stream. Flag 4 must be a no-op.
+	 */
+	if(header->encrypted == 0x04) {
+		printf("8900 plaintext image at 0x%08x; preserving payload\n", (unsigned)value);
+		free(header);
+		return;
+	}
+	if(header->encrypted != 0x03 || !header->sizeOfData ||
+	   header->sizeOfData > 32 * 1024 * 1024 ||
+	   header->sizeOfData % AES_BLOCK_SIZE) {
+		printf("Unsupported or invalid encrypted 8900 image\n");
+		free(header);
+		return;
+	}
 
 	data_begin = sizeof(header8900);
 	data_len = header->sizeOfData;
