diff --git a/hw/dma/pl080.c b/hw/dma/pl080.c
index 167b031..819a46e 100644
--- a/hw/dma/pl080.c
+++ b/hw/dma/pl080.c
@@ -90,6 +90,14 @@ static void pl080_update(PL080State *s)
     qemu_set_irq(s->irq, errlevel || tclevel);
 }
 
+static hwaddr pl080_bus_address(PL080State *s, uint32_t address)
+{
+    /* M68 iBoot passes its uncached 0x80000000 alias to the DMA engine.
+     * Preserve guest register values while resolving the bus transaction.
+     */
+    return s->s5l8900_uncached_alias ? address & 0x7fffffffU : address;
+}
+
 static void pl080_run(PL080State *s)
 {
     int c;
@@ -168,7 +176,7 @@ again:
             swidth = 1 << ((ch->ctrl >> 18) & 7);
             dwidth = 1 << ((ch->ctrl >> 21) & 7);
             for (n = 0; n < dwidth; n+= swidth) {
-                address_space_read(&s->downstream_as, ch->src,
+                address_space_read(&s->downstream_as, pl080_bus_address(s, ch->src),
                                    MEMTXATTRS_UNSPECIFIED, buff + n, swidth);
                 if (ch->ctrl & PL080_CCTRL_SI)
                     ch->src += swidth;
@@ -176,7 +184,7 @@ again:
             xsize = (dwidth < swidth) ? swidth : dwidth;
             /* ??? This may pad the value incorrectly for dwidth < 32.  */
             for (n = 0; n < xsize; n += dwidth) {
-                address_space_write(&s->downstream_as, ch->dest + n,
+                address_space_write(&s->downstream_as, pl080_bus_address(s, ch->dest + n),
                                     MEMTXATTRS_UNSPECIFIED, buff + n, dwidth);
                 if (ch->ctrl & PL080_CCTRL_DI)
                     ch->dest += swidth;
@@ -189,19 +197,19 @@ again:
                 /* Transfer complete.  */
                 if (ch->lli) {
                     ch->src = address_space_ldl_le(&s->downstream_as,
-                                                   ch->lli,
+                                                   pl080_bus_address(s, ch->lli),
                                                    MEMTXATTRS_UNSPECIFIED,
                                                    NULL);
                     ch->dest = address_space_ldl_le(&s->downstream_as,
-                                                    ch->lli + 4,
+                                                    pl080_bus_address(s, ch->lli + 4),
                                                     MEMTXATTRS_UNSPECIFIED,
                                                     NULL);
                     ch->ctrl = address_space_ldl_le(&s->downstream_as,
-                                                    ch->lli + 12,
+                                                    pl080_bus_address(s, ch->lli + 12),
                                                     MEMTXATTRS_UNSPECIFIED,
                                                     NULL);
                     ch->lli = address_space_ldl_le(&s->downstream_as,
-                                                   ch->lli + 8,
+                                                   pl080_bus_address(s, ch->lli + 8),
                                                    MEMTXATTRS_UNSPECIFIED,
                                                    NULL);
                 } else {
@@ -421,6 +429,7 @@ static void pl081_init(Object *obj)
 }
 
 static Property pl080_properties[] = {
