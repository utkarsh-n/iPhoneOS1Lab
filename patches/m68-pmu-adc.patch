+++ b/include/hw/arm/ipod_touch_pcf50633_pmu.h
@@ -27,6 +27,7 @@ OBJECT_DECLARE_SIMPLE_TYPE(Pcf50633State, PCF50633)
 typedef struct Pcf50633State {
 	I2CSlave i2c;
 	uint32_t cmd;
+    bool battery_adc_ready;
 } Pcf50633State;
 
-#endif
